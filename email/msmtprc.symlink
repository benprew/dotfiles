defaults
auth           on
tls            on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile        ~/.msmtp.log

account        gmail
host           smtp.gmail.com
port           587
from           ben.prew@gmail.com
user           ben.prew@gmail.com
passwordeval   "gpg --quiet --decrypt ~/.mbsync_password.gpg"

account default : gmail
